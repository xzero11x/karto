{
  "name": "karto",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Mapa urbano para React con MapLibre y PMTiles: temas, vistas 2D, 2.5D y 3D, alturas de edificios. Primera ciudad: Bagua (Perú).",
  "license": "UNLICENSED",
  "exports": {
    ".": {
      "types": "./dist/tipos/index.d.ts",
      "import": "./dist/karto.js"
    },
    "./estilos.css": "./dist/karto.css",
    "./vite": {
      "types": "./vite.d.mts",
      "import": "./vite.mjs"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/tipos/index.d.ts",
  "bin": {
    "karto-datos": "./bin/karto-datos.mjs"
  },
  "files": [
    "dist",
    "datos",
    "vite.mjs",
    "vite.d.mts",
    "bin"
  ],
  "sideEffects": [
    "*.css"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build --config vite.lib.config.ts && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "format": "prettier --write .",
    "version": "npm run build && git add dist",
    "teselas": "python herramientas/generar_teselas.py"
  },
  "peerDependencies": {
    "maplibre-gl": "^6.14.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@radix-ui/react-dropdown-menu": "2.2.1",
    "lucide-react": "1.56.0",
    "pmtiles": "4.5.0"
  },
  "devDependencies": {
    "@maplibre/maplibre-gl-style-spec": "26.4.4",
    "@types/geojson": "7946.0.16",
    "@types/node": "^24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "maplibre-gl": "6.14.0",
    "prettier": "3.9.10",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  }
}
